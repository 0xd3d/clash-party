#!/bin/bash
set -e
export PATH=/usr/bin:/bin:/usr/sbin:/sbin

# 设置日志文件
umask 077
LOG_FILE="/private/var/log/ClashParty-install.log"
if [[ -L "$LOG_FILE" ]] || { [[ -e "$LOG_FILE" ]] && [[ ! -f "$LOG_FILE" || "$(stat -f '%u:%l' "$LOG_FILE")" != '0:1' ]]; }; then
    echo "Refusing an unsafe installer log path" >&2
    exit 1
fi
exec >> "$LOG_FILE" 2>&1

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1"
}

# 检查 root 权限
if [ "$EUID" -ne 0 ]; then
    log "Error: Please run as root"
    exit 1
fi

# 判断 $2 是否以 .app 结尾
if [[ $2 == *".app" ]]; then
    APP_PATH="$2"
else
    APP_PATH="$2/Clash Party.app"
fi

HELPER_PATH="/Library/PrivilegedHelperTools/party.mihomo.helper"
LAUNCH_DAEMON="/Library/LaunchDaemons/party.mihomo.helper.plist"
LAUNCH_DAEMON_SOURCE="$APP_PATH/Contents/Resources/files/party.mihomo.helper.plist"

log "Starting installation..."

# 创建目录并设置权限
log "Creating directories and setting permissions..."
mkdir -p "/Library/PrivilegedHelperTools"
chmod 755 "/Library/PrivilegedHelperTools"
chown root:wheel "/Library/PrivilegedHelperTools"

# Core setuid/setgid metadata is installed transactionally by the fixed-purpose
# native identity operation after all other installer checks succeed.

# 复制 helper 工具
log "Installing helper tool..."
if [ -f "$APP_PATH/Contents/Resources/files/party.mihomo.helper" ]; then
    cp -f "$APP_PATH/Contents/Resources/files/party.mihomo.helper" "$HELPER_PATH"
    chown root:wheel "$HELPER_PATH"
    chmod 544 "$HELPER_PATH"
    log "Helper tool installed successfully"
else
    log "Error: Helper file not found at $APP_PATH/Contents/Resources/files/party.mihomo.helper"
    exit 1
fi

# Install the narrow native DNS guard without changing PF or its recovery state.
DNS_GUARD_SOURCE="$APP_PATH/Contents/Resources/files/party.mihomo.dns-guard"
DNS_GUARD_PATH="/Library/PrivilegedHelperTools/party.mihomo.dns-guard"
if [ ! -f "$DNS_GUARD_SOURCE" ]; then
    log "Error: Fixed-purpose DNS guard missing from package"
    exit 1
fi
/usr/bin/codesign --verify --strict "$DNS_GUARD_SOURCE"
DNS_GUARD_BACKUP=""
DNS_GUARD_REPLACED=0
DNS_GUARD_COMMITTED=0
rollback_guard_install() {
    result=$?
    trap - EXIT
    if [[ "$result" -ne 0 && "$DNS_GUARD_REPLACED" -eq 1 && "$DNS_GUARD_COMMITTED" -eq 0 ]]; then
        if [[ -n "$DNS_GUARD_BACKUP" && -f "$DNS_GUARD_BACKUP" ]]; then
            if ! /bin/mv -f "$DNS_GUARD_BACKUP" "$DNS_GUARD_PATH"; then
                log "Native helper rollback failed; backup retained at $DNS_GUARD_BACKUP; administrator review required"
                exit "$result"
            fi
        else
            /bin/rm -f "$DNS_GUARD_PATH"
        fi
    fi
    if [[ -n "$DNS_GUARD_BACKUP" ]]; then /bin/rm -f "$DNS_GUARD_BACKUP"; fi
    exit "$result"
}
trap rollback_guard_install EXIT
if [[ -L "$DNS_GUARD_PATH" ]] || { [[ -e "$DNS_GUARD_PATH" ]] && [[ ! -f "$DNS_GUARD_PATH" || "$(stat -f '%u:%l' "$DNS_GUARD_PATH")" != '0:1' ]]; }; then
    log "Error: Existing native helper is not a trusted unique root-owned file"
    exit 1
fi
if [[ -f "$DNS_GUARD_PATH" ]]; then
    DNS_GUARD_BACKUP="$(/usr/bin/mktemp /Library/PrivilegedHelperTools/.party.mihomo.dns-guard-backup.XXXXXX)"
    /bin/cp -p "$DNS_GUARD_PATH" "$DNS_GUARD_BACKUP"
fi
DNS_GUARD_REPLACED=1
/usr/bin/install -o root -g wheel -m 4755 "$DNS_GUARD_SOURCE" "$DNS_GUARD_PATH"
log "Installed fixed-purpose DNS guard; existing PF policy and recovery state preserved"

# 创建并配置 LaunchDaemon
log "Configuring LaunchDaemon..."
mkdir -p "/Library/LaunchDaemons"
if [ -f "$LAUNCH_DAEMON_SOURCE" ]; then
    /usr/bin/install -o root -g wheel -m 644 "$LAUNCH_DAEMON_SOURCE" "$LAUNCH_DAEMON"
    log "LaunchDaemon configured"
else
    log "Error: LaunchDaemon file not found at $LAUNCH_DAEMON_SOURCE"
    exit 1
fi

# 验证关键文件
log "Verifying installation..."
if [ ! -x "$HELPER_PATH" ]; then
    log "Error: Helper tool is not executable: $HELPER_PATH"
    exit 1
fi

# 检查二进制文件有效性
if ! file "$HELPER_PATH" | grep -q "Mach-O"; then
    log "Error: Helper tool is not a valid Mach-O binary"
    exit 1
fi

# 验证 plist 格式
if ! plutil -lint "$LAUNCH_DAEMON" >/dev/null 2>&1; then
    log "Error: Invalid plist format"
    exit 1
fi

# 获取 macOS 版本
macos_version=$(sw_vers -productVersion)
macos_major=$(echo "$macos_version" | cut -d. -f1)
log "macOS version: $macos_version"

# 启用服务（防止安全软件禁用）
if ! launchctl enable system/party.mihomo.helper 2>/dev/null; then
    log "Warning: Failed to enable service, continuing installation..."
else
    log "Service enabled successfully"
fi

# 清理现有服务
log "Cleaning up existing services..."
launchctl bootout system "$LAUNCH_DAEMON" 2>/dev/null || true
launchctl unload "$LAUNCH_DAEMON" 2>/dev/null || true

# 加载服务
log "Loading service..."
if [ "$macos_major" -ge 11 ]; then
    # macOS Big Sur 及更新版本使用 bootstrap
    if ! launchctl bootstrap system "$LAUNCH_DAEMON"; then
        log "Bootstrap failed, trying legacy load..."
        if ! launchctl load "$LAUNCH_DAEMON"; then
            log "Error: Failed to load service with both methods"
            exit 1
        fi
    fi
else
    # 旧版本使用 load
    if ! launchctl load "$LAUNCH_DAEMON"; then
        log "Error: Failed to load service"
        exit 1
    fi
fi

# 验证服务状态
log "Verifying service status..."
sleep 2
if launchctl list | grep -q "party.mihomo.helper"; then
    log "Service loaded successfully"
else
    log "Warning: Service may not be running properly"
fi

# Fix user data directory permissions
log "Fixing user data directory permissions..."
for user_home in /Users/*; do
    if [ -d "$user_home" ] && [ "$(basename "$user_home")" != "Shared" ] && [ "$(basename "$user_home")" != ".localized" ]; then
        username=$(basename "$user_home")
        user_data_dir="$user_home/Library/Application Support/mihomo-party"

        if [ -d "$user_data_dir" ]; then
            current_owner=$(stat -f "%Su" "$user_data_dir" 2>/dev/null || echo "unknown")
            if [ "$current_owner" = "root" ]; then
                log "Fixing ownership for user: $username"
                chown -R "$username:staff" "$user_data_dir" 2>/dev/null || true
                chmod -R u+rwX "$user_data_dir" 2>/dev/null || true
            fi
        fi
    fi
done

# This fixed root-only operation creates no user membership, never edits PF or
# DNS, and rolls back its own group/core-metadata transaction on ordinary errors.
# Reinstallation reuses only the recorded GeneratedUID; it never adopts another
# pre-existing group or removes active protection/recovery records.
"$DNS_GUARD_PATH" install-identity
DNS_GUARD_COMMITTED=1
log "Installation completed successfully; isolated core identity verified"

exit 0
