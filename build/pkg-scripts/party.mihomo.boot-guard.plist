<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>party.mihomo.boot-guard</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/PrivilegedHelperTools/party.mihomo.boot-guard</string>
        <string>serve</string>
    </array>
    <key>StandardErrorPath</key>
    <string>/var/log/party.mihomo.boot-guard.err</string>
    <key>StandardOutPath</key>
    <string>/var/log/party.mihomo.boot-guard.log</string>
</dict>
</plist>